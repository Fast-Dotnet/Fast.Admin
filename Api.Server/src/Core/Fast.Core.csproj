<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Fast.Admin 应用核心模块库。</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Update="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fast.Cache" />
        <PackageReference Include="Fast.DependencyInjection" />
        <PackageReference Include="Fast.DynamicApplication" />
        <PackageReference Include="Fast.IaaS" />
        <PackageReference Include="Fast.JwtBearer" />
        <PackageReference Include="Fast.Logging" />
        <PackageReference Include="Fast.OpenApi" />
        <PackageReference Include="Fast.NET.Core" />
        <PackageReference Include="Fast.Serialization.Newtonsoft.Json" />
        <PackageReference Include="Fast.Swagger" />
        <PackageReference Include="Fast.UnifyResult" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AlibabaCloud.SDK.Dysmsapi20170525" />
        <PackageReference Include="SKIT.FlurlHttpClient.Wechat.Api" />
        <PackageReference Include="SKIT.FlurlHttpClient.Wechat.TenpayV3" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" />
        <PackageReference Include="MiniExcel" />
        <PackageReference Include="ToolGood.Words.Pinyin" />
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SixLabors.Fonts" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)src\Center.Domain\Fast.Center.Domain.csproj" />
        <ProjectReference Include="$(SolutionDir)src\CenterLog.Domain\Fast.CenterLog.Domain.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <None Update="coresettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="coresettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="dbsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="dbsettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="rolepermissions.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="customrolepermissions.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>