{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Error"
    },
    "Fast": {
      // 文件格式
      "FileFormat": "_{0:yyyy}-{0:MM}",
      // 最小日志级别
      "MiniLogLevel": "Error",
      // 文件大小限制
      "FileSizeLimit": 10485760,
      // 启用 Critical
      "EnableCritical": false
    }
  },
  "AllowedHosts": "*",
  // 跨域配置
  "CorsAccessorSettings": {
    // 允许来源域名
    "WithOrigins": [
      "http://127.0.0.1:2001"
    ],
    // 客户端可获取的响应标头
    "WithExposedHeaders": [
      "Content-Disposition",
      "Fast-Response-Encipher"
    ]
  },
  // 初始化配置
  "InitializationSettings": {
    // 应用名称
    "AppName": "Fast.Admin",
    // 主题色
    "ThemeColor": "#409EFF",
    // CenterLog 库命名
    "DatabaseNaming_CenterLog": "FaCenter_Log",
    // Gateway 库命名
    "DatabaseNaming_Gateway": "FaGateway",
    // Deploy 库命名
    "DatabaseNaming_Deploy": "FaDeploy",
    // Admin 库命名
    "DatabaseNaming_Admin": "FaAdmin",
    // AdminLog 库命名
    "DatabaseNaming_AdminLog": "FaAdmin_Log",
    // 默认管理员密码
    "DefaultAdminPassword": "fast.2025",
    // 默认密码
    "DefaultPassword": "123456",
    // 默认Logo
    "DefaultLogo": "https://gitee.com/FastDotnet/Fast.Admin/raw/master/Fast.png"
  },
  // API 限流配置
  "ApiRateLimitSettingsOptions": {
    // 登录限流，单个Ip与设备Id组合在统计窗口内允许的请求数
    "LoginPermitLimit": 10,
    // 登录限流，单个Ip在统计窗口内允许的请求数
    "LoginIpPermitLimit": 30,
    // 已登录限流，单个会话在统计窗口内允许的请求数；未登录时按单个Ip与设备Id组合统计
    "PermitLimit": 120,
    // 单个Ip在统计窗口内允许的请求数
    "IpPermitLimit": 60,
    // 统计窗口秒数
    "WindowSeconds": 60
  },
  // JWT Token 配置
  "JWTSettings": {
    // 启用
    "Enable": true,
    // 是否验证密钥
    "ValidateIssuerSigningKey": true,
    // 签名密钥，string 类型，必须是复杂密钥，长度等于32
    "IssuerSigningKey": "Xh6<>-L*d%/Qg)cktH[]t3tk{tFZ%=9R",
    // 是否验证签发方
    "ValidateIssuer": true,
    // 签发方，string 类型
    "ValidIssuer": "Fast.Admin",
    // 是否验证签收方
    "ValidateAudience": true,
    // 签收方，string 类型
    "ValidAudience": "Fast.Apply",
    // 是否验证过期时间
    "ValidateLifetime": true,
    // 是否验证 AssessToken
    "ValidateAccessToken": true,
    // Token 过期时间，单位分钟
    "TokenExpiredTime": 30,
    // 刷新Token 过期时间，单位分钟
    "RefreshTokenExpireTime": 1440,
    // 过期时间容错值，单位秒
    "ClockSkew": 5
  },
  // Swagger 配置
  "SwaggerSettings": {
    // 禁用
    "Enable": false
  }
}
