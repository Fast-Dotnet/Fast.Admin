{
	"name": "Fast.App",
	"appid": "__UNI__9D0B9F8",
	"description": "Fast.Admin 移动管理端",
	"versionName": "1.0.0",
	"versionCode": "100000",
	"app-plus": {
		"compatible": {
			"ignoreVersion": true,
			"runtimeVersion": "5.26",
			"compilerVersion": "5.26"
		},
		"usingComponents": true,
		"nvueStyleCompiler": "uni-app",
		"compilerVersion": 3,
		"darkmode": true,
		"themeLocation": "theme.json",
		"safearea": {
			"background": "#ffffff",
			"backgroundDark": "#07111c",
			"bottom": {
				"offset": "auto"
			}
		},
		"softinput": {
			"navBar": "auto",
			"auxiliary": false,
			"mode": "adjustResize"
		},
		"splashscreen": {
			"alwaysShowBeforeRender": true,
			"waiting": true,
			"autoclose": true
		},
		"modules": {
			"Barcode": {},
			"Camera": {},
			"VideoPlayer": {},
			"Geolocation": {},
			"Maps": {},
			"UIWebview": {}
		},
		"distribute": {
			"android": {
				"permissions": [
					"<uses-permission android:name=\"android.permission.INTERNET\" />",
					"<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\" />",
					"<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\" />",

					"<uses-permission android:name=\"android.permission.WAKE_LOCK\" />",
					"<uses-permission android:name=\"android.permission.VIBRATE\" />",
					"<uses-permission android:name=\"android.permission.CAMERA\" />",

					"<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\" />",
					"<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\" />"
				],
				"permissionExternalStorage": {
					"request": "none"
				},
				"permissionPhoneState": {
					"request": "none"
				},
				"minSdkVersion": 24,
				"targetSdkVersion": 35,
				"abiFilters": ["armeabi-v7a", "arm64-v8a"]
			},
			"ios": {
				"dSYMs": false,
				"idfa": false,
				"UIBackgroundModes": ["audio"],
				"privacyDescription": {
					"NSCameraUsageDescription": "用于扫描二维码、拍摄业务照片及上传相关图片，仅在您主动使用对应功能时访问摄像头。",
					"NSPhotoLibraryUsageDescription": "用于从系统相册选择业务图片并上传，例如个人头像、业务附件及相关凭证。",
					"NSPhotoLibraryAddUsageDescription": "用于将您主动选择保存的业务图片或二维码保存到系统相册。",
					"NSLocationWhenInUseUsageDescription": "用于在您使用定位或地图选点功能时获取当前位置，以便完成相关业务操作。"
				}
			},
			"sdkConfigs": {
				"geolocation": {
					"system": {
						"__platform__": ["ios", "android"]
					}
				},
				"maps": {},
				"push": {}
			},
			"splashscreen": {
				"androidStyle": "common",
				"useOriginalMsgbox": false
			},
			"icons": {
				"android": {
					"hdpi": "public/72x72.png",
					"xhdpi": "public/96x96.png",
					"xxhdpi": "public/144x144.png",
					"xxxhdpi": "public/192x192.png"
				},
				"ios": {
					"appstore": "public/1024x1024.png",
					"ipad": {
						"app": "public/76x76.png",
						"app@2x": "public/152x152.png",
						"notification": "public/20x20.png",
						"notification@2x": "public/40x40.png",
						"proapp@2x": "public/167x167.png",
						"settings": "public/29x29.png",
						"settings@2x": "public/58x58.png",
						"spotlight": "public/40x40.png",
						"spotlight@2x": "public/80x80.png"
					},
					"iphone": {
						"app@2x": "public/120x120.png",
						"app@3x": "public/180x180.png",
						"notification@2x": "public/40x40.png",
						"notification@3x": "public/60x60.png",
						"settings@2x": "public/58x58.png",
						"settings@3x": "public/87x87.png",
						"spotlight@2x": "public/80x80.png",
						"spotlight@3x": "public/120x120.png"
					}
				}
			}
		},
		"nativePlugins": {}
	},
	"app-harmony": {
		"darkmode": true,
		"themeLocation": "theme.json",
		"safearea": {
			"background": "#ffffff",
			"backgroundDark": "#07111c",
			"bottom": {
				"offset": "none"
			}
		},
		"distribute": {
			"bundleName": "com.fastdotnet.app",
			"icons": {
				"foreground": "public/1024x1024.png",
				"background": "public/1024x1024.png"
			},
			"splashScreens": {
				"startWindowBackground": "#ffffff",
				"startWindowIcon": "public/192x192.png"
			},
			"modules": {
				"uni-location": {
					"system": {}
				}
			}
		}
	},
	"mp-weixin": {
		"usingComponents": true,
		"appid": "wx1e4b5c59fb34d91f",
		"libVersion": "latest",
		"mergeVirtualHostAttributes": true,
		"darkmode": true,
		"themeLocation": "theme.json",
		"setting": {
			"urlCheck": false,
			"es6": true,
			"minified": true,
			"postcss": true
		},
		"plugins": {},
		"permission": {
			"scope.userLocation": {
				"desc": "用于在您主动使用定位或地图选点功能时获取当前位置，辅助完成相关业务操作。"
			}
		},
		"requiredPrivateInfos": ["getLocation", "chooseLocation"],
		"requiredBackgroundModes": ["audio"],
		"optimization": {
			"subPackages": true
		}
	},
	"h5": {
		"title": "Fast.App",
		"darkmode": true,
		"themeLocation": "theme.json",
		"devServer": {
			"port": 2010,
			"https": false
		},
		"router": {
			"mode": "history"
		}
	},
	"quickapp": {
		"usingComponents": true
	},
	"mp-alipay": {
		"usingComponents": true
	},
	"mp-baidu": {
		"usingComponents": true
	},
	"mp-toutiao": {
		"usingComponents": true
	},
	"uniStatistics": {
		"enable": false
	},
	"vueVersion": "3",
	"locale": "zh-Hans",
	"fallbackLocale": "zh-Hans"
